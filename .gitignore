# Dependencias y artefactos de compilacion
/_build/
/deps/
/cover/
/doc/
/.fetch
erl_crash.dump
credo-debug-log.html
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/

# El PLT de dialyzer se regenera: guarda rutas absolutas del entorno donde se
# construyo, y en otro host no sirve (ver el topic del sandbox).
/priv/plts/

# El paquete que construye `mix hex.build` y el directorio donde lo despliega
# el trabajo `package` de CI.
/build/
*.tar

# El log del servidor que arranca `probes/f2_datos.sh`: pesa y no es
# evidencia (la evidencia es el resumen que imprime).
/probes/output/*.log

# Ficheros del sistema operativo
.DS_Store
Thumbs.db

# Editores
.idea/
.vscode/
*.swp
